# SHEPHERD Full-Stack Local Development Environment
# Copy this file to .env (or individual service .env files) for local development.
# Never commit real credentials or production secrets to Git.

# ---------------------------------------------------------------------------
# Frontend (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Core API (services/api)
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
USE_IN_MEMORY_ADAPTER=true

# Supabase (Required when USE_IN_MEMORY_ADAPTER=false)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_EVIDENCE_BUCKET=shepherd-evidence
SUPABASE_REPORTS_BUCKET=shepherd-reports

# ---------------------------------------------------------------------------
# Server-to-Server Intelligence Microservice (services/intelligence)
# ---------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8001
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=replace-with-a-local-development-secret
AI_SERVICE_TIMEOUT_SECONDS=30.0

# Optional AI Provider (Future expansion)
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Notifications & SafeCircle
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER=mock
NOTIFICATION_API_KEY=
NOTIFICATION_SENDER=SHEPHERD
