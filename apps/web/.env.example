# SHEPHERD web application — environment variables
#
# Copy this file to .env.local and fill in the values you need.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put a
# Supabase service-role key, database password or other backend secret here.

# ---------------------------------------------------------------------------
# Core API
# ---------------------------------------------------------------------------
# Base URL of the SHEPHERD Core API, for example https://api.example.com/api/v1
# Leave empty to use the isolated local mock adapter by default.
NEXT_PUBLIC_API_BASE_URL=

# true  -> always use the synthetic mock adapter (safe for demos)
# false -> always call NEXT_PUBLIC_API_BASE_URL
# unset -> mock when the base URL is empty, live when it is configured
NEXT_PUBLIC_USE_MOCK_API=true

# ---------------------------------------------------------------------------
# Supabase authentication (optional)
# ---------------------------------------------------------------------------
# When these are absent the app runs a clearly labelled local demo session.
# Use only the public anon key from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Metadata
# ---------------------------------------------------------------------------
# Used for absolute metadata URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
