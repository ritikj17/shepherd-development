# SHEPHERD Core API Configuration
# Copy to .env for local development. Never commit .env or real secrets.

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Supabase (Required when USE_IN_MEMORY_ADAPTER=false)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Verification
# Provide SUPABASE_JWKS_URL (or SUPABASE_URL to derive it) and/or SUPABASE_JWT_SECRET
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Private Storage Buckets
SUPABASE_EVIDENCE_BUCKET=shepherd-evidence
SUPABASE_REPORTS_BUCKET=shepherd-reports

# Intelligence API (Server-to-Server)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=30.0

# Upload Limits
MAX_EVIDENCE_UPLOAD_BYTES=10485760

# Development / Testing Adapter (MUST be false in production)
USE_IN_MEMORY_ADAPTER=false
